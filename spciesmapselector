<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Colonial waterbird colonies</title>
  <link rel="stylesheet" href="https://js.arcgis.com/4.31/esri/themes/light/main.css" />
  <script src="https://js.arcgis.com/4.31/"></script>
  <style>
    html, body, #viewDiv { margin: 0; height: 100%; width: 100%; }
    #panel { background: #fff; padding: 10px; box-shadow: 0 1px 4px rgba(0,0,0,.3); font-family: sans-serif; font-size: 13px; }
    #panel label { display: block; margin-top: 6px; font-weight: 600; }
    #panel select { width: 220px; font-size: 14px; padding: 4px; margin-top: 2px; }
    #msg { margin-top: 6px; color: #666; }
  </style>
</head>
<body>
  <div id="viewDiv"></div>
  <div id="panel">
    <label for="fieldSelect">Species</label>
    <select id="fieldSelect"></select>
    <label for="yearSelect">Year</label>
    <select id="yearSelect"></select>
    <div id="msg"></div>
  </div>

  <script>
    const LAYER_URL = " 
https://services.arcgis.com/ audubon.maps /arcgis/rest/services/ TX_Colonial_Waterbird_Annual_Survey_1973_to_Present_View /FeatureServer/0";

    // Field name -> label. Check the codes against your data dictionary.
    const FIELDS = [
      { value: "total_breeding_pairs", label: "All species (total pairs)" },
      { value: "whpe_pairs_count", label: "American White Pelican" },
      { value: "brpe_pairs_count", label: "Brown Pelican" },
      { value: "dcco_pairs_count", label: "Double-crested Cormorant" },
      { value: "neco_pairs_count", label: "Neotropic Cormorant" },
      { value: "anhi_pairs_count", label: "Anhinga" },
      { value: "ameg_pairs_count", label: "American (Great) Egret" },
      { value: "gbhe_pairs_count", label: "Great Blue Heron" },
      { value: "sneg_pairs_count", label: "Snowy Egret" },
      { value: "lbhe_pairs_count", label: "Little Blue Heron" },
      { value: "trhe_pairs_count", label: "Tricolored Heron" },
      { value: "reeg_pairs_count", label: "Reddish Egret" },
      { value: "bcnh_pairs_count", label: "Black-crowned Night-Heron" },
      { value: "ycnh_pairs_count", label: "Yellow-crowned Night-Heron" },
      { value: "wece_pairs_count", label: "Western Cattle Egret" },
      { value: "whib_pairs_count", label: "White Ibis" },
      { value: "wfib_pairs_count", label: "White-faced Ibis" },
      { value: "rosp_pairs_count", label: "Roseate Spoonbill" },
      { value: "lagu_pairs_count", label: "Laughing Gull" },
      { value: "gbte_pairs_count", label: "Gull-billed Tern" },
      { value: "cate_pairs_count", label: "Caspian Tern" },
      { value: "rote_pairs_count", label: "Royal Tern" },
      { value: "sate_pairs_count", label: "Sandwich Tern" },
      { value: "fote_pairs_count", label: "Forster's Tern" },
      { value: "lete_pairs_count", label: "Least Tern" },
      { value: "sote_pairs_count", label: "Sooty Tern" },
      { value: "blsk_pairs_count", label: "Black Skimmer" },
      { value: "amoy_pairs_count", label: "American Oystercatcher" }
    ];

    require([
      "esri/Map",
      "esri/views/MapView",
      "esri/layers/FeatureLayer",
      "esri/smartMapping/renderers/size",
      "esri/widgets/Legend"
    ], function (Map, MapView, FeatureLayer, sizeRendererCreator, Legend) {

      const layer = new FeatureLayer({ url: LAYER_URL, outFields: ["*"] });
      const map = new Map({ basemap: "gray-vector", layers: [layer] });
      const view = new MapView({ container: "viewDiv", map, center: [-95.5, 28.5], zoom: 7 });

      view.ui.add(new Legend({ view }), "bottom-left");
      view.ui.add("panel", "top-right");

      const fieldSel = document.getElementById("fieldSelect");
      const yearSel = document.getElementById("yearSelect");
      const msg = document.getElementById("msg");
      FIELDS.forEach(f => fieldSel.add(new Option(f.label, f.value)));

      async function update() {
        const fieldName = fieldSel.value;
        const year = yearSel.value;
        const label = FIELDS.find(f => f.value === fieldName).label;

        // Only show colonies that have this species in the chosen year
        layer.definitionExpression = `year = ${year} AND ${fieldName} > 0`;

        const count = await layer.queryFeatureCount({ where: layer.definitionExpression });
        msg.textContent = count ? `${count} colonies` : "No colonies for this selection";
        if (!count) return;

        const { renderer } = await sizeRendererCreator.createContinuousRenderer({
          layer,
          view,
          field: fieldName,
          minSize: 6,
          maxSize: 45,
          sizeOptimizationEnabled: true,
          defaultSymbolEnabled: false,
          legendOptions: { title: `${label} (breeding pairs)` }
        });
        layer.renderer = renderer;

        layer.popupTemplate = {
          title: "{colony_name} ({year})",
          content:
            `<b>${label}:</b> {${fieldName}} pairs<br>` +
            `<b>Total breeding pairs:</b> {total_breeding_pairs}<br>` +
            `<b>Site category:</b> {site_category}<br>` +
            `<b>Colony status:</b> {colony_status}`
        };
      }

      async function init() {
        await layer.load();
        // Build the year list from the data
        const res = await layer.queryFeatures({
          where: "1=1",
          outFields: ["year"],
          returnDistinctValues: true,
          returnGeometry: false
        });
        const years = res.features.map(f => f.attributes.year)
          .filter(y => y != null).sort((a, b) => b - a);
        years.forEach(y => yearSel.add(new Option(y, y)));

        fieldSel.addEventListener("change", update);
        yearSel.addEventListener("change", update);
        await view.when();
        update();
      }
      init();
    });
  </script>
</body>
</html>
